// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  SISWA
  CALON_WARGA
  WARGA

  SUPER_ADMIN
  ADMIN
}

model User {
  id                String  @id @default(uuid())
  name              String?
  username          String? @unique
  encryptedPassword String? @map("encrypted_password") @db.Char(60)

  email         String?   @unique
  emailVerified DateTime? @map("email_verified")

  phone         String?   @unique
  phoneVerified DateTime? @map("phone_verified")

  branchId  Int?    @map("branch_id")
  subBranch String? @map("sub_branch")

  image String?
  roles UserRole[] @default([])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts       Account[]
  authenticators Authenticator[]
  person         Person?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  likes          PostLike[]
  particiption   Participant[]
}

model Person {
  id       String  @id @default(uuid())
  identity String? @unique
  name     String?
  gender   Gender?

  birthPlace String?   @map("birth_place")
  birthDate  DateTime? @map("birth_date")

  religion  String?
  education String?
  ocupation String?
  address   String?

  branchId    Int?    @map("branch_id")
  subBranchId String?
  userId      String? @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch    Branch?    @relation(fields: [branchId], references: [id])
  subBranch SubBranch? @relation(fields: [subBranchId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  id                   String  @id @default(cuid())
  credentialID         String  @unique @map("credential_id")
  userId               String  @map("user_id")
  providerAccountId    String  @map("provider_account_id")
  credentialPublicKey  String  @map("credential_public_key")
  counter              Int
  credentialDeviceType String  @map("credential_device_type")
  credentialBackedUp   Boolean @map("credential_backed_up")
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id   Int    @id
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  people      Person[]
  subBranches SubBranch[]
}

model SubBranch {
  id       String @id @default(cuid())
  branchId Int    @map("branch_id")
  name     String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  people Person[]
  branch Branch   @relation(fields: [branchId], references: [id])
}

model PostLike {
  userId String @map("user_id")
  postId String @map("post_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, postId])
}

model PostView {
  postId String @id @map("post_id")
  views  Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Participant {
  userId String @map("user_id")
  postId String @map("post_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, postId])
}
